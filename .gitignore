# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Audio and generated binaries
audio/*
!audio/.gitkeep

# Vault: raw sources are gitignored (may be copyrighted or large); concepts/episodes ARE committed.
vault/sources/*
!vault/sources/.gitkeep
vault/inbox/*
!vault/inbox/.gitkeep

# Runtime state
state/*.db
state/*.jsonl

# OS / editors
.DS_Store
.idea/
.vscode/

# Obsidian metadata (if vault is symlinked here)
.obsidian/workspace*
.obsidian/cache

# Logs
*.log
