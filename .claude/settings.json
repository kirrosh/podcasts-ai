{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m podcasts.build *)",
      "Bash(python -m podcasts.transcribe *)",
      "Bash(python -m podcasts.ingest *)",
      "Bash(uv sync)",
      "Bash(uv run *)",
      "Bash(uv pip install *)",
      "Bash(ffprobe *)",
      "Bash(ffmpeg -version)",
      "Bash(ls *)",
      "Bash(cat vault/*)",
      "Bash(cat scripts/*)",
      "Bash(mkdir -p *)",
      "Bash(touch *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)"
    ]
  }
}
