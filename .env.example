# Copy to .env and fill in. .env is gitignored.

# Yandex Cloud — SpeechKit TTS + STT
# Create an API key in Yandex Cloud IAM; grant ai.speechkit-tts.user + ai.speechkit-stt.user roles.
YC_API_KEY=
YC_FOLDER_ID=

# SaluteSpeech (Sber) — optional, enables the "salutespeech" TTS provider.
# Register at https://developers.sber.ru, create a SaluteSpeech personal cabinet,
# press "Get key" — Sber hands you a ready base64 Authorization key. Paste it
# below verbatim. Scope defaults to SALUTE_SPEECH_PERS (freemium, 200k chars/mo).
SBER_AUTH_KEY=
SBER_SCOPE=SALUTE_SPEECH_PERS

# Telegram bot token — used by Claude Code Channels plugin.
# Usually set via `/telegram:configure <token>` in Claude Code; listed here for reference.
TELEGRAM_BOT_TOKEN=
